# Self-hosted PostgreSQL (required for memory persistence)
# Can point directly at Postgres or through PgBouncer (transaction pooling):
#   postgresql://user:password@pgbouncer:6432/remember
DATABASE_URL=postgresql://remember:remember@localhost:5432/remember
# Optional: max connections in the pg pool (default 10)
# DATABASE_POOL_MAX=10

# Optional: direct Postgres endpoint used by auto-migrations on boot.
# Required only when DATABASE_URL points at PgBouncer (transaction pooling
# cannot run DDL). Falls back to DATABASE_URL when unset.
# MIGRATION_DATABASE_URL=postgresql://remember:remember@localhost:5432/remember
# Optional: set to "false" to disable auto-migrate on server start (default true)
# AUTO_MIGRATE=true

# Self-hosted Redis (optional — short-term context + rate limiting)
# REDIS_URL=redis://localhost:6379

# Upstream Main AI (required for chat)
UPSTREAM_PROVIDER=openai
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=your-openai-api-key

# Gateway Auth (optional; client → gateway bearer token)
# GATEWAY_API_KEY=your-gateway-api-key

# Gateway URL (used by the MCP layer / GatewayClient to reach the gateway;
# defaults to http://localhost:8787 when unset)
# GATEWAY_URL=http://localhost:8787

# Optional Memory AI compressor (keep false until needed)
MEMORY_AI_ENABLED=false
# MEMORY_AI_PROVIDER=openrouter
# MEMORY_AI_BASE_URL=https://openrouter.ai/api/v1
# MEMORY_AI_MODEL=cheap-model
# MEMORY_AI_API_KEY=

# Groq memory extraction (hybrid fact extraction fallback)
# Get a key: https://console.groq.com/keys
# GROQ_API_KEY=your-groq-api-key
# GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b

# Context + logging
CONTEXT_BUDGET=8000
LOG_LEVEL=info
