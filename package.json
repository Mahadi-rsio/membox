{
  "name": "remember-memory-gateway",
  "version": "0.1.0",
  "description": "AI Memory Gateway - Cloudflare Workers with Hono, Neon, Drizzle ORM, and Upstash Redis",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.6.0",
    "hono": "^4.13.7",
    "opencode-ai": "^1.18.30",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^20.17.19",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.3",
    "wrangler": "^4.131.1"
  }
}
